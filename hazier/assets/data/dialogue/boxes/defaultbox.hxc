import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.play.cutscene.dialogue.ConversationState;
import funkin.play.cutscene.dialogue.DialogueBox;
import funkin.audio.FunkinSound;

class DefaultDialogueBox extends DialogueBox {
	function new() {
		super('defaultbox');
	}

  public function onDialogueLine(event:DialogueScriptEvent):Void {
    super.onDialogueLine(event);
    
    // silly lil danganronpa sound for progressing thru the text
    var progressSfx = FunkinSound.load(Paths.sound("general/progressDialog"), true);
    progressSfx.volume = 0.5;
    progressSfx.play(false);


  }

  override function onDestroy(event:ScriptEvent) {
    super.onDestroy(event);
  }
}

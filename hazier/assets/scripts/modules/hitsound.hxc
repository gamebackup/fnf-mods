import funkin.Paths;
import funkin.audio.FunkinSound;
import funkin.modding.module.Module;
import funkin.play.PlayState;
import flixel.FlxG;
import funkin.Preferences;

class HitSoundModule extends Module
{
    var hitSoundChannel:FunkinSound = null;

    public function new()
    {
        super("HitSound", 0);
    }

    override function onNoteHit(event)
    {
        super.onNoteHit(event);

        // Checks if this is running ingame
        if (PlayState?.instance?.currentStage == null) return;

        // hit sfx
        if (event.note.noteData.getMustHitNote())
        {
            // Get hitsound volume from preferences (0-100) and convert to decimal (0-1)
            var volumePercent:Float = Preferences.hitsoundVolume / 100.0;
            
            // Only play if volume is greater than 0
            if (volumePercent > 0)
            {
                // Stop and clean up previous hitsound properly
                if (hitSoundChannel != null)
                {
                    if (hitSoundChannel.playing)
                    {
                        hitSoundChannel.stop();
                    }
                    hitSoundChannel.destroy();
                    hitSoundChannel = null;
                }

                var index:Int = FlxG.random.int(1, 2);
                hitSoundChannel = FunkinSound.playOnce(Paths.sound("Hit_" + index), volumePercent);
            }
        }
    }
    
    override function onSongRetry(event:ScriptEvent):Void
    {
        super.onSongRetry(event);
        
        // Clean up hitsound on retry
        if (hitSoundChannel != null)
        {
            if (hitSoundChannel.playing)
            {
                hitSoundChannel.stop();
            }
            hitSoundChannel.destroy();
            hitSoundChannel = null;
        }
    }
    
    override function onSongEnd(event:ScriptEvent):Void
    {
        super.onSongEnd(event);
        
        // Clean up hitsound when song ends
        if (hitSoundChannel != null)
        {
            if (hitSoundChannel.playing)
            {
                hitSoundChannel.stop();
            }
            hitSoundChannel.destroy();
            hitSoundChannel = null;
        }
    }
}
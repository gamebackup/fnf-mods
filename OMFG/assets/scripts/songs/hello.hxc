import funkin.play.song.Song;
import funkin.play.PlayState;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxTween;
import flixel.FlxG;
import funkin.save.Save;

class HelloSong extends Song
{
    var blackScreen:FunkinSprite;
    var fadeStarted:Bool = false;

    function new()
    {
        super('hello');
    }

    // NEW tag
    public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
    {
        return !Save.instance.hasBeatenSong(this.id, null, this.variation);
    }

    override function onCreate(event:ScriptEvent):Void
    {
        super.onCreate(event);

        // reset states every time the song loads
        fadeStarted = false;
        blackScreen = null;
    }

    public override function onCountdownStart(event:CountdownScriptEvent):Void
    {
        super.onCountdownStart(event);

        if (blackScreen != null) return;

        blackScreen = new FunkinSprite(0, 0);
        blackScreen.makeSolidColor(FlxG.width, FlxG.height, 0xFF000000);
        blackScreen.scrollFactor.set(0, 0);
        blackScreen.cameras = [PlayState.instance.camHUD];
        blackScreen.alpha = 1;

        PlayState.instance.add(blackScreen);
        PlayState.instance.refresh();
    }

    public override function onStepHit(event:SongStepScriptEvent):Void
    {
        super.onStepHit(event);

        if (!fadeStarted && event.step >= 10 && blackScreen != null)
        {
            fadeStarted = true;

            FlxTween.tween(blackScreen, { alpha: 0 }, 3, {
                onComplete: function(_)
                {
                    if (blackScreen != null)
                    {
                        blackScreen.destroy();
                        blackScreen = null;
                    }
                }
            });
        }
    }

    override function onSongRetry(event:ScriptEvent):Void
    {
        super.onSongRetry(event);

        // clean up if player restarts the song
        if (blackScreen != null)
        {
            blackScreen.destroy();
            blackScreen = null;
        }

        fadeStarted = false;
    }

    override function destroy():Void
    {
        if (blackScreen != null)
        {
            blackScreen.destroy();
            blackScreen = null;
        }

        super.destroy();
    }
}